{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npm run typecheck",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "seed": "node scripts/seed-supabase.mjs",
    "seed:force": "node scripts/seed-supabase.mjs --force",
    "dev:web": "npm -w bluehazy-fm run dev",
    "dev": "npm run dev:web",
    "start": "npm -w bluehazy-fm run preview"
  },
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
